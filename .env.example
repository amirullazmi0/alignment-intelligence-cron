# Alamat backend collector (FastAPI). Hanya dibaca di sisi server.
COLLECTOR_API_URL="http://127.0.0.1:5003"
# Harus sama dengan COLLECTOR_INTERNAL_TOKEN milik backend. Tidak pernah dikirim ke browser.
# Dipakai juga untuk memanggil endpoint auth kolektor, jadi endpoint itu tetap tertutup
# bagi siapa pun selain server dashboard ini.
COLLECTOR_INTERNAL_TOKEN=
